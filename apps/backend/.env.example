# =============================================================================
# LAUNDELLE CENTRALIZED BACKEND — Production Environment Template
# =============================================================================
# Copy this file to .env.local or configure these in the Vercel Project Settings.
# In production, all secrets MUST be randomly generated, isolated, and rotated.
# Obvious defaults, placeholders, or strings containing 'dev-laundelle' or 
# 'whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET' will trigger fatal startup guards.
# =============================================================================

# Node Environment
NODE_ENV=production

# -----------------------------------------------------------------------------
# 1. Database (MongoDB Atlas)
# -----------------------------------------------------------------------------
# Use a production replica set URI with TLS enabled (mongodb+srv://)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/laundelle_production?retryWrites=true&w=majority
MONGODB_DB_NAME=laundelle_production

# -----------------------------------------------------------------------------
# 2. Cryptographic Secrets (Minimum 32 bytes / 64 hex characters)
# Generate each with: openssl rand -hex 32
# -----------------------------------------------------------------------------
# JWT signing secret (Used for backend token generation & internal verification)
JWT_SECRET=

# Secret key for encrypting sensitive in-app order PINs (AES-256-GCM)
ORDER_PIN_ENCRYPTION_KEY=

# Secret key used for signing driver offline sync vouchers (HMAC-SHA256)
OFFLINE_VOUCHER_SECRET=

# Secret key used for signing and verifying temporary file download URLs
FILE_SIGNING_SECRET=

# Secret used to authorize Vercel cron triggers and scheduled maintenance jobs
CRON_SECRET=

# -----------------------------------------------------------------------------
# 3. Stripe Payments & Webhooks (UK Commercial Mode)
# -----------------------------------------------------------------------------
# Live secret key: starts with sk_live_
STRIPE_SECRET_KEY=sk_live_...
# Webhook signing secret: starts with whsec_ (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_API_VERSION=2025-06-30.basil

# -----------------------------------------------------------------------------
# 4. Email Delivery (Resend UK Commercial Domain)
# -----------------------------------------------------------------------------
# Resend API key (starts with re_)
RESEND_API_KEY=re_...
# Verified sending email on laundelle.co.uk
EMAIL_FROM=Laundelle <notifications@laundelle.co.uk>
EMAIL_SUPPORT=support@laundelle.co.uk

# -----------------------------------------------------------------------------
# 5. Auth0 Authentication & Management API
# -----------------------------------------------------------------------------
AUTH0_DOMAIN=auth.laundelle.co.uk
AUTH0_ISSUER_BASE_URL=https://auth.laundelle.co.uk/
AUTH0_AUDIENCE=https://api.laundelle.co.uk
AUTH0_CLIENT_ID=
# Machine-to-Machine credentials for Auth0 Management API (staff provisioning/sync)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_MANAGEMENT_AUDIENCE=https://auth.laundelle.co.uk/api/v2/
AUTH0_DB_CONNECTION=Username-Password-Authentication

# -----------------------------------------------------------------------------
# 6. SMS & Telephony (Twilio - Optional Fallback)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# 7. AI Garment & Care Assistant (Google Gemini)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 8. Portal URLs & Allowed CORS Origins
# -----------------------------------------------------------------------------
APP_URL=https://customer.laundelle.co.uk
ADMIN_URL=https://admin.laundelle.co.uk
OPERATIONS_URL=https://ops.laundelle.co.uk
ALLOWED_ORIGINS=https://customer.laundelle.co.uk,https://ops.laundelle.co.uk,https://admin.laundelle.co.uk,https://laundelle.co.uk,https://www.laundelle.co.uk

# -----------------------------------------------------------------------------
# 9. Super Administrator Seed & Bootstrap
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@laundelle.co.uk
ADMIN_PHONE=+447000000000
ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_SUB=
